rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ปิดทั้งหมดโดยเจตนา: เบราว์เซอร์ไม่อ่าน/เขียน Firestore ตรง ๆ
    // ทุกอย่างผ่าน API ของเรา (Admin SDK ฝั่ง server ไม่ถูก rules นี้บังคับ) — ดู src/lib/server/store.ts
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
