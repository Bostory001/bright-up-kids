rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ร่างแรก: ปิดทั้งหมดไว้ก่อน — เปิดทีละ collection ตอนทำแต่ละรอบใน ROADMAP.md
    // หลักการ: player_profiles / attempts / redemptions เขียนได้จาก server (Admin SDK) เท่านั้น กันเด็กแก้ XP/เหรียญ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
