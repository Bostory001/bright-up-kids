        "required": true,
        "description": ""
      },
      {
        "name": "phone",
        "type": "string",
        "required": false,
        "description": ""
      },
      {
        "name": "passwordHash",
        "type": "string",
        "required": true,
        "description": "รหัสผ่านที่ hash แล้ว (scrypt) ไม่ส่งออก API"
      },
      {
        "name": "mustChangePassword",
