        "type": "string",
        "required": false,
        "description": "กุญแจ 2FA (TOTP) ไม่ส่งออก API"
      },
      {
        "name": "totpEnabled",
        "type": "boolean",
        "required": false,
        "description": "เปิดใช้ 2FA แล้ว — บังคับสำหรับเจ้าของและครู"
      },
      {
        "name": "failedLogins",
        "type": "number",
        "required": false,
        "description": "จำนวนครั้งที่ใส่รหัสผิดติดกัน"
